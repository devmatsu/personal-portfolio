<header class="site-header">
  <div class="nav-shell">
    <a href="/" class="logo mono" aria-label="Matsu home">~/matsu<span>_</span></a>
    <nav aria-label="Primary">
      <a href="/#now">Now</a>
      <a href="/#experience">Experience</a>
      <a href="/#agents">How it’s built</a>
      <a href="/#contact">Contact</a>
    </nav>
    <button class="search mono" type="button" aria-haspopup="dialog" data-palette-open><span>Search</span><kbd>⌘K</kbd></button>
  </div>
</header>
<style>
  .site-header { width: 100%; max-width: var(--maxw); margin: 0 auto; padding: 20px 24px; }
  .nav-shell { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:16px; padding:10px 10px 10px 20px; border:1px solid rgba(var(--text-rgb),.08); border-radius:16px; background:rgba(var(--text-rgb),.02); }
  .logo { font-size:15px; font-weight:500; }
  .logo span { color:var(--accent); }
  nav { display:flex; flex-wrap:wrap; gap:4px; font-size:14px; }
  nav a { padding:8px 14px; border-radius:10px; color:var(--muted); }
  nav a:hover { background:rgba(var(--text-rgb),.05); opacity:1; }
  .search { display:inline-flex; align-items:center; gap:10px; padding:8px 12px; border:0; border-radius:10px; background:rgba(var(--text-rgb),.06); color:var(--muted); font-size:12px; cursor:pointer; }
  kbd { padding:1px 6px; border:1px solid rgba(var(--text-rgb),.15); border-radius:5px; font:inherit; }
  /* Small screens: section links move into the search palette (Sections group) instead of wrapping into three rows. */
  @media (max-width: 640px) { nav { display: none; } }
  @media (hover: none) { kbd { display: none; } }
</style>
<script>
  document.querySelector('[data-palette-open]')?.addEventListener('click', () => window.dispatchEvent(new CustomEvent('palette:open')));
</script>
