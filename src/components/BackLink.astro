---
interface Props {
  href: string;
  label: string;
  /** Below 460px, show only the arrow in a 44px square; the label stays as the accessible name. */
  compact?: boolean;
}
const { href, label, compact = false } = Astro.props;
---
<a class:list={['back', { compact }]} href={href}><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg><span class="text">{label}</span></a>
<style>
  .back { display: inline-flex; align-items: center; gap: 8px; min-height: 42px; padding: 8px 16px 8px 12px; border: 1px solid rgba(var(--text-rgb), .1); border-radius: 10px; color: var(--muted); font-size: 15px; font-weight: 500; transition: color .15s, border-color .15s; }
  .back:hover, .back:focus-visible { color: var(--text); border-color: rgba(var(--text-rgb), .22); opacity: 1; }
  .back svg { flex: none; transition: transform .15s; }
  .back:hover svg { transform: translateX(-2px); }
  @media (max-width: 459px) {
    .compact { flex: none; justify-content: center; width: 44px; min-height: 44px; padding: 0; }
    /* Same as the global .sr-only, only on phones. */
    .compact .text { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  }
</style>
