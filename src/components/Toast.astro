<div class="toast-region" role="status" aria-live="polite" aria-atomic="true">
  <div class="toast" data-toast>
    <span class="dot" aria-hidden="true"></span>
    <span data-toast-message></span>
  </div>
</div>
<script>
  // Event contract: window 'toast' with { message: string; tone?: 'success' | 'error' }.
  const toast = document.querySelector<HTMLElement>('[data-toast]');
  const message = toast?.querySelector<HTMLElement>('[data-toast-message]');
  let timeout: number | undefined;

  window.addEventListener('toast', (event) => {
    if (!toast || !message) return;
    message.textContent = event.detail.message;
    toast.dataset.tone = event.detail.tone ?? 'success';
    toast.dataset.visible = 'true';
    window.clearTimeout(timeout);
    timeout = window.setTimeout(() => {
      toast.dataset.visible = 'false';
      window.setTimeout(() => {
        if (toast.dataset.visible !== 'true') message.textContent = '';
      }, 160);
    }, 2500);
  });
</script>
<style>
  .toast-region{position:fixed;inset:0;pointer-events:none;z-index:1000}
  .toast{position:absolute;left:50%;bottom:24px;z-index:1000;transform:translateX(-50%) translateY(8px);display:flex;align-items:center;gap:10px;max-width:calc(100vw - 32px);padding:10px 16px;border:1px solid rgba(var(--text-rgb),.12);border-radius:12px;background:var(--surface);color:var(--text);font-size:14px;box-shadow:0 16px 48px rgba(0,0,0,.5);opacity:0;visibility:hidden;pointer-events:none;transition:opacity 160ms ease,transform 160ms ease,visibility 160ms}
  .toast[data-visible="true"]{opacity:1;visibility:visible;pointer-events:auto;transform:translateX(-50%) translateY(0)}
  .dot{width:8px;height:8px;flex:none;border-radius:50%;background:var(--ok)}
  .toast[data-tone="error"] .dot{background:var(--error)}
  @media(prefers-reduced-motion:reduce){.toast{transition:opacity 160ms ease,visibility 160ms}}
</style>
