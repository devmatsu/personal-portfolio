---
import { WIDGETS, type WidgetInfo } from '../data/widgets';
interface Props { current: WidgetInfo['slug'] }
const { current } = Astro.props;
---
<nav class="switcher" aria-label="Switch widget">
  <ul>
    {WIDGETS.map((widget) => <li><a href={`/widgets/${widget.slug}`} aria-current={widget.slug === current ? 'page' : undefined}>{widget.short}</a></li>)}
  </ul>
</nav>
<style>
  ul { display:flex; gap:2px; margin:0; padding:3px; list-style:none; border:1px solid rgba(var(--text-rgb), .1); border-radius:12px; }
  a { display:flex; align-items:center; min-height:34px; padding:0 14px; border-radius:9px; color:var(--muted); font-size:14px; font-weight:500; transition:color .15s, background-color .15s; }
  a:hover { color:var(--text); background:rgba(var(--text-rgb), .05); opacity:1; }
  a[aria-current] { color:var(--text); background:rgba(var(--text-rgb), .08); }
  /* Four widgets don't fit one row below ~360px: an even 2×2 grid instead of overflowing. */
  @media (max-width: 359px) {
    ul { display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); }
    a { justify-content:center; }
  }
</style>
