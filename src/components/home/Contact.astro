---
import { SITE } from '../../data/site';
---
<section id="contact" class="container contact">
  <h2>Let’s ship something<span>.</span></h2>
  <div class="links">
    <a class="email" href={`mailto:${SITE.email}`}>{SITE.email}<span>↗</span></a>
    <div class="social"><a href={SITE.links.linkedin}>LinkedIn</a><a href={SITE.links.github}>GitHub</a><a href={SITE.links.devto}>dev.to</a></div>
  </div>
</section>
<style>
.contact{padding-top:160px;padding-bottom:96px;display:flex;flex-wrap:wrap;gap:32px;align-items:flex-end;justify-content:space-between}.contact h2{margin:0;flex:999 1 520px;font-size:clamp(40px,5vw,64px);line-height:1.05;letter-spacing:-.035em;font-weight:600}.contact h2 span{color:var(--accent)}.links{flex:1 1 280px;display:flex;flex-direction:column;gap:10px}.email{padding:16px 20px;border-radius:14px;background:var(--accent);color:var(--on-accent);font-weight:600;display:flex;justify-content:space-between}.social{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;font-size:14px}.social a{padding:12px;border-radius:12px;border:1px solid rgba(var(--text-rgb),.12);text-align:center}
</style>