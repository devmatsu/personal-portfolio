---
import { SITE } from '../../data/site';
---
<section id="top" class="hero">
  <div class="glow" aria-hidden="true"></div>
  <div class="container hero-content">
    <div class="intro">
      <h1>{SITE.name}</h1>
      <p class="nickname">Matsu <span class="mono">/ˈma.tsu/</span> — what friends call me.</p>
      <p class="headline">Senior Software Engineer building with <span class="break"><span class="accent">Agentic Engineering</span>.</span></p>
      <div class="actions"><a class="btn btn-primary" href="#experience">View experience <span aria-hidden="true">→</span></a><a class="btn btn-ghost" href="#workflow">View workflow <span aria-hidden="true">→</span></a></div>
    </div>
    <div class="divider" aria-hidden="true"></div>
    <slot />
  </div>
</section>
<style>
.hero{position:relative;flex:1;display:flex;flex-direction:column;justify-content:center;min-height:0}.glow{position:absolute;top:-80px;right:-120px;width:720px;height:600px;background:radial-gradient(closest-side,rgba(var(--accent-rgb),.12),transparent);pointer-events:none}.hero-content{position:relative;display:flex;flex-wrap:wrap;gap:56px;align-items:center;padding-block:32px 128px}.intro{flex:1 1 100%;min-width:0}h1{margin:0;font-size:clamp(48px,6vw,72px);line-height:1.05;letter-spacing:-.035em;font-weight:600}.nickname{margin:12px 0 0;font-size:18px;color:var(--dim)}.nickname .mono{font-size:15px;color:var(--faint)}.headline{margin:32px 0 0;font-size:clamp(24px,2.8vw,32px);line-height:1.25;letter-spacing:-.02em;font-weight:500;color:var(--text)}.break{display:block}.accent{color:var(--accent)}.actions{margin-top:36px;display:flex;flex-wrap:wrap;gap:12px}.divider{display:none}
@media (min-width:1100px){.hero-content{display:grid;grid-template-columns:minmax(0,1fr) 1px clamp(380px,50vw - 165px,440px);column-gap:clamp(40px,4vw,64px);align-items:center}.divider{display:block;align-self:stretch;position:relative;background:rgba(var(--text-rgb),.08)}.divider::after{content:'';position:absolute;left:0;top:50%;width:1px;height:48px;transform:translateY(-50%);background:var(--accent);opacity:.8}}
.hero{overflow-x:clip}
</style>
