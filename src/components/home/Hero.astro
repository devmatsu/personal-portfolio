---
import { Image } from 'astro:assets';
import avatar from '../../assets/avatar.png';
import { SITE } from '../../data/site';
import { EXPERIENCE } from '../../data/experience';

const current = EXPERIENCE[0];
---
<section id="top" class="hero">
  <div class="glow" aria-hidden="true"></div>
  <div class="container hero-content">
    <div class="intro">
      <div class="role"><Image src={avatar} alt={SITE.name} width={40} height={40} /><span>{current.title} · <span class="company">{current.company}</span></span></div>
      <h1>{SITE.name}</h1>
      <p class="nickname">Matsu <span class="mono">/ˈma.tsu/</span> — what friends call me.</p>
      <p class="description">Backend engineer for systems that can’t go down. Node.js, TypeScript and AWS — and now building with AI agents.</p>
      <div class="actions"><a class="btn btn-primary" href="#experience">See my work</a><a class="btn btn-ghost" href="#agents">Watch the agents build →</a></div>
    </div>
    <slot />
  </div>
  <a class="scroll mono" href="#now" aria-label="Scroll to content">scroll<span class="cue"></span></a>
</section>
<style>
.hero{position:relative;flex:1;display:flex;flex-direction:column;justify-content:center;min-height:0}.glow{position:absolute;top:-80px;right:-120px;width:720px;height:600px;background:radial-gradient(closest-side,rgba(var(--accent-rgb),.16),transparent);pointer-events:none}.hero-content{position:relative;display:flex;flex-wrap:wrap;gap:56px;align-items:center;padding-block:48px}.intro{flex:999 1 520px;min-width:0}.role{display:flex;align-items:center;gap:12px;color:var(--muted);font-size:14px}.role img{width:40px;height:40px;border-radius:50%;object-fit:cover}.company{color:var(--text)}h1{margin:24px 0 0;font-size:clamp(48px,6vw,72px);line-height:1.05;letter-spacing:-.035em;font-weight:600}.nickname{margin:12px 0 0;font-size:18px;color:var(--dim)}.nickname .mono{font-size:15px;color:var(--faint)}.description{margin:32px 0 0;max-width:46ch;font-size:18px;line-height:1.6;color:var(--muted)}.actions{margin-top:32px;display:flex;flex-wrap:wrap;gap:12px}.scroll{align-self:center;margin:8px 0 28px;display:flex;flex-direction:column;align-items:center;gap:10px;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--faint)}.cue{width:1px;height:40px;background:linear-gradient(to bottom,var(--accent),transparent)}
.hero{overflow-x:clip}
</style>