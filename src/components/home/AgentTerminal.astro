---
const lines = [
  { who: 'matsu', type: 'matsu', text: 'issue: add experience timeline' },
  { who: 'agent', type: 'agent', text: 'reading CLAUDE.md, docs/adr/…' },
  { who: 'agent', type: 'agent', text: 'plan: content collection + component' },
  { who: 'agent', type: 'agent', text: 'commit: feat(experience): timeline' },
  { who: 'ci', type: 'ci', text: 'lint ✓  types ✓  tests ✓' },
  { who: 'ci', type: 'ci', text: 'lighthouse ✓  preview deployed' },
  { who: 'agent', type: 'agent', text: 'opened PR — ready for review' },
  { who: 'matsu', type: 'matsu', text: 'approved · merged to v3' },
];
---
<aside class="terminal">
  <span class="sr-only">An example agent workflow: issue, planning, implementation, checks, pull request, and merge.</span>
  <div class="bar" aria-hidden="true"><div class="lights"><i></i><i></i><i></i></div><span class="session mono">agent session · example</span><span class="live mono"><i></i>live</span></div>
  <div class="output mono" aria-hidden="true" data-terminal>
    {lines.map((line) => <div class="line" data-line><span class={`who ${line.type}`}>{line.who}</span><span class="text">{line.text}</span></div>)}
    <div class="prompt"><span>›</span><span class="cursor"></span></div>
  </div>
</aside>
<script>
  const terminal = document.querySelector<HTMLElement>('[data-terminal]');
  const allLines = terminal?.querySelectorAll<HTMLElement>('[data-line]');
  if (terminal && allLines) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let timer = 0;
    let count = allLines.length;
    const render = () => allLines.forEach((line, index) => { line.hidden = index >= count; });
    // Reserve the fully revealed height so the box never grows while lines appear, even when long lines wrap on phones.
    const reserve = () => {
      terminal.style.minHeight = '';
      allLines.forEach((line) => { line.hidden = false; });
      terminal.style.minHeight = `${terminal.offsetHeight}px`;
      render();
    };
    const start = () => {
      window.clearInterval(timer);
      if (reduced.matches) { count = allLines.length; render(); return; }
      count = 1;
      render();
      timer = window.setInterval(() => {
        count = count >= allLines.length ? 1 : count + 1;
        render();
      }, 1100);
    };
    reserve();
    start();
    reduced.addEventListener('change', start);
    new ResizeObserver(reserve).observe(terminal.parentElement ?? terminal);
  }
</script>
<style>
.terminal{flex:1 1 380px;max-width:440px;min-width:0;border-radius:18px;border:1px solid rgba(var(--text-rgb),.1);background:var(--term);box-shadow:0 24px 60px -30px rgba(0,0,0,.7),0 0 0 1px rgba(var(--accent-rgb),.04)}.bar{display:flex;align-items:center;justify-content:space-between;padding:12px 16px;border-bottom:1px solid rgba(var(--text-rgb),.07)}.lights{display:flex;gap:6px}.lights i,.live i{width:10px;height:10px;border-radius:50%;background:rgba(var(--text-rgb),.14)}.session,.live{font-size:11px;color:var(--dim)}.live{display:inline-flex;align-items:center;gap:6px;color:var(--ok)}.live i{width:6px;height:6px;background:var(--ok)}.output{padding:18px 18px 22px;font-size:12px;line-height:1.85}.line,.prompt{display:flex;gap:10px}.line{animation:fadein .2s ease}.who{flex:0 0 64px}.who.matsu{color:var(--accent)}.who.agent{color:var(--agent)}.who.ci{color:var(--ok)}.text{color:var(--term-text);min-width:0}.prompt>span:first-child{flex:0 0 64px;color:var(--dim)}.cursor{display:inline-block;width:8px;height:16px;background:var(--accent);animation:blink 1s step-end infinite}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
</style>