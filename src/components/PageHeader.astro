---
import BackLink from './BackLink.astro';
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  /** Optional one-sentence version of `description`, shown instead of it on narrow screens. */
  shortDescription?: string;
  back?: { href: string; label: string };
}
const { eyebrow, title, description, shortDescription, back } = Astro.props;
const hasAside = Astro.slots.has('aside');
---
<header class:list={['page-header', 'container', { 'has-back': back }]}>
  {back && <div class:list={['top', { 'has-aside': hasAside }]}>
    <BackLink href={back.href} label={back.label} compact={hasAside} />
    <slot name="aside" />
  </div>}
  {eyebrow && <p class="label">{eyebrow}</p>}
  <h1>{title}<span>.</span></h1>
  {description && !shortDescription && <p class="description">{description}</p>}
  {description && shortDescription && <>
    <p class="description long">{description}</p>
    <p class="description short">{shortDescription}</p>
  </>}
</header>
<style>
  .page-header { padding-block: 72px 48px; }
  .page-header.has-back { padding-top: 40px; }
  h1 { margin: 12px 0; font-size: clamp(40px, 5vw, 56px); line-height: 1.1; font-weight: 600; letter-spacing: -.035em; }
  h1 span { color: var(--accent); }
  .description { max-width: 60ch; margin: 0; color: var(--muted); }
  .short { display: none; }
  @media (max-width: 560px) {
    .long { display: none; }
    .short { display: block; }
  }
  .top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 28px; }
  /* Phones: the icon-only back link and the aside (the widget switcher) share one row. */
  @media (max-width: 459px) {
    .has-aside { flex-wrap: nowrap; gap: 8px; }
  }
</style>
