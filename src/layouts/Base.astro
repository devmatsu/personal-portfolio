---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';
import Toast from '../components/Toast.astro';
import InlineScript from '../components/InlineScript.astro';
import jsFlag from '../scripts/js-flag.js?raw';
import transitionDirection from '../scripts/transition-direction.js?raw';
import searchShortcutLabel from '../scripts/search-shortcut-label.js?raw';
import { inlineScriptHash } from '../lib/csp';
import { SITE } from '../data/site';
// Nav renders this inline script in <body>, after the CSP <meta> is written, so its hash is registered here.
Astro.csp?.insertScriptHash(inlineScriptHash(searchShortcutLabel));
interface Props { title?: string; description?: string; image?: string }
const { title, description = SITE.description, image = `${SITE.url}/images/page_preview.png` } = Astro.props;
const pageTitle = title ? `${title} · Matsu` : SITE.title;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/icons/devmatsu.ico" />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <InlineScript code={jsFlag} />
    <InlineScript code={transitionDirection} />
  </head>
  <body>
    <a class="skip-link" href="#main" data-astro-prefetch="false">Skip to content</a>
    <Nav />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
    <CommandPalette />
    <Toast />
  </body>
</html>
