---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Poker from '../../widgets/poker/Poker';
import WidgetSwitcher from '../../components/WidgetSwitcher.astro';

const description = "Texas Hold'em equity for your hand against up to nine opponents: exact when every deal can be counted, simulated when not.";
---

<Base title="Poker Odds" description={description}>
  <PageHeader back={{ href: '/widgets', label: 'All widgets' }} title="Poker Odds" description={description}>
    <WidgetSwitcher slot="aside" current="poker" />
  </PageHeader>
  <div class="container page">
    <div class="island"><Poker client:only="react" /></div>
  </div>
</Base>

<style>
  .page { padding-bottom: 100px; }
  .island { min-height: 720px; }
</style>
