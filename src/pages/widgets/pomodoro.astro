---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Pomodoro from '../../widgets/pomodoro/Pomodoro';

const description = 'A focused timer with customizable sessions and breaks.';
---

<Base title="Pomodoro" description={description}>
  <PageHeader eyebrow="Widgets" title="Pomodoro" description={description} />
  <div class="container">
    <div class="island"><Pomodoro client:only="react" /></div>
    <p class="back"><a href="/widgets">← All widgets</a></p>
  </div>
</Base>

<style>
  .island { min-height: 760px; }
  .back { margin: 24px 0 48px; color: var(--muted); }
  .back a:hover { color: var(--text); }
</style>
