---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { WIDGETS } from '../../data/widgets';
---

<Base title="Widgets" description="Small tools I actually use.">
  <PageHeader title="Widgets" description="Small tools I actually use." />
  <div class="container page">
    <div class="grid">
      {WIDGETS.map((widget) => <a class="widget card" href={`/widgets/${widget.slug}`}>
        <div class="visual" aria-hidden="true">
          {widget.slug === 'rubik' && <span class="digits mono">0:42.18</span>}
          {widget.slug === 'roulette' && <span class="wheel" />}
          {widget.slug === 'pomodoro' && <span class="ring"><span>25:00</span></span>}
          {widget.slug === 'poker' && <span class="cards"><span>A<b>♠</b></span><span class="red">K<b>♥</b></span></span>}
        </div>
        <div class="copy"><h2>{widget.name}<span>.</span></h2><p>{widget.description}</p></div>
      </a>)}
    </div>
  </div>
</Base>

<style>
  .page { padding-bottom: 100px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); gap: 16px; }
  .widget { display: flex; flex-direction: column; gap: 24px; transition: border-color .2s, transform .2s; }
  .widget:hover { border-color: rgba(var(--accent-rgb), .35); transform: translateY(-2px); }
  .visual { min-height: 160px; display: grid; place-items: center; border-radius: 14px; background: radial-gradient(ellipse at center, rgba(var(--accent-rgb), .1), transparent 70%), var(--term); }
  .digits { font-size: 36px; color: var(--text); }
  .wheel { width: 108px; aspect-ratio: 1; border-radius: 50%; background: conic-gradient(var(--accent) 0 25%, rgba(var(--accent-rgb), .3) 25% 50%, var(--accent) 50% 75%, rgba(var(--accent-rgb), .3) 75%); border: 5px solid rgba(var(--text-rgb), .12); }
  .ring { width: 92px; aspect-ratio: 1; border-radius: 50%; border: 5px solid rgba(var(--text-rgb), .12); border-top-color: var(--accent); display: grid; place-items: center; font: 14px var(--font-mono); }
  .cards { display: flex; gap: 10px; }
  .cards span { display: grid; justify-items: center; align-content: center; gap: 2px; width: 52px; height: 72px; border: 1px solid rgba(var(--text-rgb), .16); border-radius: 9px; background: var(--term); color: var(--text); font-weight: 600; font-size: 19px; line-height: 1; }
  .cards span:first-child { transform: rotate(-6deg); }
  .cards span:last-child { transform: rotate(6deg) translateY(4px); }
  .cards b { font-weight: 600; font-size: 17px; }
  .cards .red { color: var(--error); }
  .copy h2 { margin: 0 0 6px; font-size: 24px; letter-spacing: -.03em; }
  .copy h2 span { color: var(--accent); }
  .copy p { margin: 0; color: var(--muted); }
</style>
