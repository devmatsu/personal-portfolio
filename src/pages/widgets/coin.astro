---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Coin from '../../widgets/coin/Coin';
import WidgetSwitcher from '../../components/WidgetSwitcher.astro';

const description = 'Heads or tails in one tap. Nothing to choose, just flip.';
---

<Base title="Coin Flip" description={description}>
  <PageHeader back={{ href: '/widgets', label: 'All widgets' }} title="Coin Flip" description={description}>
    <WidgetSwitcher slot="aside" current="coin" />
  </PageHeader>
  <div class="container page">
    <div class="island"><Coin client:only="react" /></div>
  </div>
</Base>

<style>
  .page { padding-bottom: 100px; }
  .island { min-height: 600px; }
</style>
