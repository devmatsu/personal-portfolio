---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Timer from '../../widgets/rubik/Timer';
---

<Base title="Rubik's Cube Timer" description="A Rubik's cube timer with WCA-style scrambles and session statistics.">
  <div class="container page">
    <PageHeader eyebrow="Widgets" title="Rubik's Cube Timer" description="A clean timer, random-move scrambles and session stats." />
    <section class="timer-card card" aria-label="Rubik's cube timer">
      <div class="timer-island"><Timer client:only="react" /></div>
    </section>
    <a class="back mono" href="/widgets">← All widgets</a>
  </div>
</Base>

<style>
  .page { padding-block: 64px 100px; }
  .timer-island { min-height: 650px; }
  .back { display: inline-block; margin-top: 26px; color: var(--dim); font-size: 13px; }
  .back:hover { color: var(--accent); }
</style>
