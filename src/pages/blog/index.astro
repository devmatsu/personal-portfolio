---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getArticles } from '../../lib/devto';

const articles = await getArticles();
const dateLabel = (date: string) =>
  new Intl.DateTimeFormat('en-US', { month: 'short', day: '2-digit', year: 'numeric', timeZone: 'UTC' })
    .format(new Date(date)).toUpperCase();
---

<Base title="Blog" description="Notes on backend, databases and building with agents — also on dev.to.">
  <div class="container blog-page">
    <PageHeader eyebrow="Writing" title="Blog" description="Notes on backend, databases and building with agents — also on dev.to." />
    <section class="articles" aria-label="Articles">
      {articles.map((article) => (
        <a class="article card" href={`/blog/post/${article.id}`}>
          <span class="label date">{dateLabel(article.published_at)}</span>
          <h2>{article.title}</h2>
          <p class="description">{article.description}</p>
          <div class="tags">{article.tag_list.map((tag) => <span class="tag">{tag}</span>)}</div>
          <span class="reading mono">{article.reading_time_minutes} min read</span>
        </a>
      ))}
    </section>
  </div>
</Base>

<style>
  .blog-page { padding-top: 48px; padding-bottom: 88px; }
  .articles { display: grid; grid-template-columns: 1fr; gap: 16px; margin-top: 40px; }
  .article { display: flex; flex-direction: column; align-items: flex-start; min-width: 0; color: var(--text); text-decoration: none; }
  .date { font-size: 11px; }
  h2 { margin: 16px 0 8px; font-size: 21px; line-height: 1.3; letter-spacing: -.025em; }
  .description { margin: 0; color: var(--muted); }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
  .reading { margin-top: auto; padding-top: 20px; color: var(--dim); font-size: 12px; }
  .article:hover h2 { color: var(--accent); }
  @media (min-width: 860px) { .articles { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
