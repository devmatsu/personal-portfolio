---
import Base from '../../../layouts/Base.astro';
import { getArticle, getArticles } from '../../../lib/devto';

export async function getStaticPaths() {
  // Sequential on purpose: parallel detail requests trip dev.to's rate limit (429).
  const paths = [];
  for (const { id } of await getArticles()) {
    paths.push({ params: { id: String(id) }, props: { article: await getArticle(id) } });
  }
  return paths;
}

const { article } = Astro.props;
const dateLabel = new Intl.DateTimeFormat('en-US', {
  month: 'short', day: '2-digit', year: 'numeric', timeZone: 'UTC',
}).format(new Date(article.published_at)).toUpperCase();
---

<Base title={article.title} description={article.description} image={article.social_image}>
  <article class="container post">
    <a class="back" href="/blog">← All posts</a>
    <div class="meta mono">{dateLabel} <span aria-hidden="true">·</span> {article.reading_time_minutes} min read</div>
    <h1>{article.title}</h1>
    <div class="tags">{article.tag_list.map((tag) => <span class="tag">{tag}</span>)}</div>
    {article.cover_image && <img class="cover" src={article.cover_image} alt="" />}
    <div class="prose" set:html={article.body_html} />
    <a class="devto" href={article.url} target="_blank" rel="noreferrer">Read / comment on dev.to ↗</a>
  </article>
</Base>

<style>
  .post { max-width: 860px; padding-top: 48px; padding-bottom: 88px; }
  .back { display: inline-block; color: var(--muted); margin-bottom: 34px; }
  .back:hover, .devto:hover { color: var(--accent); }
  .meta { color: var(--dim); font-size: 12px; text-transform: uppercase; letter-spacing: .06em; }
  h1 { margin: 16px 0; font-size: clamp(36px, 5vw, 56px); line-height: 1.1; letter-spacing: -.04em; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .cover { display: block; max-width: 100%; width: 100%; height: auto; margin: 32px 0; border-radius: 16px; }
  .prose { margin-top: 40px; color: var(--text); overflow-wrap: anywhere; }
  .prose :global(h1), .prose :global(h2), .prose :global(h3), .prose :global(h4) { margin: 1.8em 0 .65em; line-height: 1.25; letter-spacing: -.025em; }
  .prose :global(h1) { font-size: 2em; }
  .prose :global(h2) { font-size: 1.65em; }
  .prose :global(h3) { font-size: 1.3em; }
  .prose :global(p), .prose :global(ul), .prose :global(ol) { margin: 1.15em 0; }
  .prose :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.5em; }
  .prose :global(li + li) { margin-top: .35em; }
  .prose :global(blockquote) { margin: 1.5em 0; padding: 4px 0 4px 20px; border-left: 3px solid var(--accent); color: var(--muted); }
  .prose :global(code) { padding: .15em .4em; border-radius: 5px; background: rgba(var(--text-rgb), .06); font-family: var(--font-mono); font-size: .88em; }
  .prose :global(pre) { max-width: 100%; overflow-x: auto; padding: 20px; border: 1px solid rgba(var(--text-rgb), .07); border-radius: 12px; background: var(--term); color: var(--term-text); font: 13px/1.65 var(--font-mono); }
  .prose :global(pre code) { padding: 0; background: none; font-size: inherit; }
  .prose :global(img), .prose :global(video), .prose :global(iframe) { max-width: 100%; border-radius: 12px; }
  .prose :global(iframe) { width: 100%; min-height: 360px; }
  .prose :global(table) { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; }
  .prose :global(th), .prose :global(td) { padding: 10px 12px; border: 1px solid rgba(var(--text-rgb), .14); text-align: left; }
  .prose :global(th) { background: rgba(var(--text-rgb), .05); }
  .devto { display: inline-block; margin-top: 40px; color: var(--muted); }
  /* dev.to ships a JS-driven copy/fullscreen panel inside code blocks; it's inert here. */
  .prose :global(.highlight__panel) { display: none; }
  @media (prefers-reduced-motion: reduce) { .prose :global(*) { scroll-behavior: auto; } }
</style>
